DATAINSIGHT_APP_NAME=DataInsight AI
DATAINSIGHT_ENVIRONMENT=development
DATAINSIGHT_DEBUG=true
DATAINSIGHT_API_PREFIX=/api
DATAINSIGHT_AUTO_CREATE_TABLES=true

DATAINSIGHT_MYSQL_HOST=127.0.0.1
DATAINSIGHT_MYSQL_PORT=3306
DATAINSIGHT_MYSQL_USER=root
DATAINSIGHT_MYSQL_PASSWORD=change-me
DATAINSIGHT_MYSQL_DATABASE=datainsight_ai

# Replace this value with a random string of at least 32 characters.
DATAINSIGHT_JWT_SECRET_KEY=replace-with-a-long-random-secret-key
DATAINSIGHT_JWT_ALGORITHM=HS256
DATAINSIGHT_ACCESS_TOKEN_EXPIRE_MINUTES=60

DATAINSIGHT_DATASET_STORAGE_DIR=../datasets
DATAINSIGHT_REPORT_STORAGE_DIR=../reports
DATAINSIGHT_MAX_UPLOAD_SIZE_MB=50
DATAINSIGHT_MAX_ML_ROWS=5000

# Phase 6 AI analyst. Keep the key blank until you are ready to call the API.
DATAINSIGHT_OPENAI_API_KEY=
DATAINSIGHT_OPENAI_BASE_URL=https://api.openai.com/v1
DATAINSIGHT_OPENAI_MODEL=gpt-5.6-terra
DATAINSIGHT_OPENAI_API_MODE=responses
DATAINSIGHT_OPENAI_REASONING_EFFORT=medium
DATAINSIGHT_OPENAI_MAX_OUTPUT_TOKENS=1200
DATAINSIGHT_OPENAI_TIMEOUT_SECONDS=60
DATAINSIGHT_AI_MAX_HISTORY_MESSAGES=12
